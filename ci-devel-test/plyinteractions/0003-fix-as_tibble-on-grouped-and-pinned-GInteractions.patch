From e8cbecf0413a70e6046cd1d4bf73ae35a67b6e47 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 3 Oct 2026 13:13:40 +0000
Subject: [PATCH 3/3] fix: as_tibble() on grouped and pinned GInteractions

anchors() on a grouped or pinned GInteractions dropped every argument but `x`,
so first(), second() and as.data.frame() failed with 'unused argument (type =
"first")', and so did as_tibble(): a grouped or pinned GInteractions could not
be turned into a data frame. anchors() now passes its arguments on to the
underlying GInteractions.

The setters behind mutate() of core fields (start1, strand2, ...) reached
the same error; now that anchors() works, they would rebuild a plain
GInteractions and silently drop the grouping or the pinning. mutate() now
stops with an explicit error instead, asking to ungroup() or unpin() first,
except for the widths of an anchored PinnedGInteractions, which have their own
setters.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FLbRhpc2hEajWKBL7zXM8Q
---
 R/methods-DelegatingGInteractions.R     |  4 +++-
 R/mutate.R                              | 26 +++++++++++++++++++++
 man/delegating-ginteractions-methods.Rd |  2 +-
 tests/testthat/test-dplyr.R             | 30 ++++++++++++++++++++++++-
 4 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/R/methods-DelegatingGInteractions.R b/R/methods-DelegatingGInteractions.R
index e9e1ddb..f677f13 100644
--- a/R/methods-DelegatingGInteractions.R
+++ b/R/methods-DelegatingGInteractions.R
@@ -68,7 +68,9 @@ setMethod("strand2", "DelegatingGInteractions",
     function(x) strand2(x@delegate)
 )
 #' @rdname delegating-ginteractions-methods
-setMethod("anchors", "DelegatingGInteractions", function(x) anchors(x@delegate))
+setMethod("anchors", "DelegatingGInteractions", 
+    function(x, ...) anchors(x@delegate, ...)
+)
 #' @rdname delegating-ginteractions-methods
 setMethod("regions", "DelegatingGInteractions", function(x) regions(x@delegate))
 #' @rdname delegating-ginteractions-methods
diff --git a/R/mutate.R b/R/mutate.R
index 4b396da..5062fb0 100644
--- a/R/mutate.R
+++ b/R/mutate.R
@@ -107,6 +107,32 @@ mutate.GInteractions <- function(.data, ...) {
         .data
     }
 
+    ## Core fields of grouped or pinned GInteractions cannot be modified in 
+    ## place: the setters below rebuild a plain GInteractions, which would 
+    ## silently drop the grouping or the pinning. Only the widths of an 
+    ## AnchoredPinnedGInteractions have dedicated setters.
+    if (is(.data, "DelegatingGInteractions")) {
+        supported <- if (is(.data, "AnchoredPinnedGInteractions")) {
+            c("width1", "width2") 
+        } else {
+            character(0)
+        }
+        unsupported <- setdiff(core_cols, supported)
+        if (length(unsupported)) {
+            undo <- if (is(.data, "GroupedGInteractions")) {
+                c("grouped", "ungroup()")
+            } else {
+                c("pinned", "unpin()")
+            }
+            stop(
+                "Core fields of a ", undo[[1]], " GInteractions cannot be ",
+                "modified (", paste0("`", unsupported, "`", collapse = ", "),
+                "): `", undo[[2]], "` it first.",
+                call. = FALSE
+            )
+        }
+    }
+
     for (col in core_cols) {
         modifier <- match.fun(paste0("set_", col))
         .data <- modifier(.data, .mutated[[col]])
diff --git a/man/delegating-ginteractions-methods.Rd b/man/delegating-ginteractions-methods.Rd
index 8bda66c..36ace7c 100644
--- a/man/delegating-ginteractions-methods.Rd
+++ b/man/delegating-ginteractions-methods.Rd
@@ -51,7 +51,7 @@
 
 \S4method{strand2}{DelegatingGInteractions}(x)
 
-\S4method{anchors}{DelegatingGInteractions}(x)
+\S4method{anchors}{DelegatingGInteractions}(x, ...)
 
 \S4method{regions}{DelegatingGInteractions}(x)
 
